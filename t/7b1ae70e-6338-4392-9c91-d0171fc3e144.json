{"id": "7b1ae70e-6338-4392-9c91-d0171fc3e144", "title": "Boston Red Sox ABC my First alphabet book", "type": "Book", "year": "2009", "fiction": "", "ages": "CHILDREN", "summary": "This alphabet book introduces young readers to the world of baseball through the lens of the Boston Red Sox team. Each letter of the alphabet is associated with a specific aspect of the Red Sox organization, such as players, positions, equipment, and terms related to the sport. Through vibrant illustrations and simple text, children learn the alphabet while also gaining familiarity with baseball and the iconic Boston Red Sox team.", "then_and_now": "", "cover": "img/c-7b1ae70e-633.jpg", "creators": [{"name": "Brad Epstein", "role": "author", "lead": "Brad M.", "more": "", "photo": ""}], "links": [{"label": "Find it", "link": "https://search.worldcat.org/title/426812220?oclcNum=426812220"}], "quote": null, "groups": [{"label": "Characters", "facet": "character", "part": "Describe", "pieces": [{"name": "Base Runner", "image": "", "sentence": "", "locator": "", "about": "", "real": "fiction", "kind": "Character", "credit": "", "caption": "", "on_map": "", "access": "", "link": "", "also": [], "also_count": 0}, {"name": "Bobby Doerr", "image": "img/p-f85a844d-03b.jpg", "sentence": "", "locator": "", "about": "Robert Pershing Doerr was an American professional baseball second baseman and coach. He played his entire 14-year Major League Baseball (MLB) career for the Boston Red Sox (1937–1951). A nine-time MLB All-Star, Doerr batted over .300 three times, drove in more than 100 runs six times, and set Red Sox team records in several statistical categories despite missing one season due to military service during World War II. He was inducted into the Baseball Hall of Fame in 1986.", "real": "real", "kind": "Athlete", "credit": "", "caption": "", "on_map": "", "access": "", "link": "https://en.wikipedia.org/wiki/Bobby_Doerr", "also": [], "also_count": 0}, {"name": "Carlton Fisk", "image": "img/p-f119ade9-636.jpg", "sentence": "", "locator": "", "about": "Carlton Ernest Fisk, nicknamed \"Pudge\" and \"the Commander\", is an American former professional baseball catcher who played 24 seasons in Major League Baseball (MLB) for the Boston Red Sox and the Chicago White Sox. In 1972, he was the first player to be unanimously voted American League (AL) Rookie of the Year. Fisk is best known for his game-winning home run in the 12th inning of Game 6 of the 1975 World Series, during which he memorably waved his arms hoping for the batted ball to remain fair.", "real": "real", "kind": "Athlete", "credit": "", "caption": "", "on_map": "", "access": "", "link": "https://en.wikipedia.org/wiki/Carlton_Fisk", "also": [], "also_count": 0}, {"name": "Catcher", "image": "", "sentence": "", "locator": "", "about": "", "real": "real", "kind": "Athlete", "credit": "", "caption": "", "on_map": "", "access": "", "link": "", "also": [], "also_count": 0}, {"name": "Joe Cronin", "image": "img/p-9655a532-0ff.jpg", "sentence": "", "locator": "", "about": "Joseph Edward Cronin was an American professional baseball player, manager and executive. He played in Major League Baseball (MLB) as a shortstop, most notably as a member of the Boston Red Sox. Cronin spent over 48 years in baseball, culminating with 14 years as president of the American League (AL).", "real": "real", "kind": "Athlete", "credit": "", "caption": "", "on_map": "", "access": "", "link": "https://en.wikipedia.org/wiki/Joe_Cronin", "also": [], "also_count": 0}, {"name": "Pitcher", "image": "", "sentence": "", "locator": "", "about": "", "real": "real", "kind": "Athlete", "credit": "", "caption": "", "on_map": "", "access": "", "link": "", "also": [], "also_count": 0}, {"name": "Umpire", "image": "img/p-0cb1d5e0-7e8.jpg", "sentence": "", "locator": "", "about": "An umpire is an official in a variety of sports and competition, responsible for enforcing the rules of the sport, including sportsmanship decisions such as ejecti